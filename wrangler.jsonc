{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fire-system",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "hszhe9.com",
      "custom_domain": true
    }
  ]
}
